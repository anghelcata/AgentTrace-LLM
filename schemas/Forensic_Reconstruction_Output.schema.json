{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttrace-llm.local/schema/forensic_reconstruction_output_v1_3.json",
  "title": "AgentTrace-LLM Forensic Reconstruction Output v1.3",
  "description": "Evidence-supported post-incident reconstruction returned by the forensic investigator. Incident status refers specifically to an agentic-system execution-integrity compromise, not merely to a domain incident described by the evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_status",
    "execution_context_finding",
    "root_event_finding",
    "timeline",
    "claim_relations",
    "exposed_agents",
    "contaminated_agents",
    "corrective_agents",
    "provenance_findings",
    "impact_finding",
    "evidence_integrity_finding",
    "evidence_gaps",
    "overall_confidence",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "incident_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "support_status",
        "supporting_artifact_ids"
      ],
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "INCIDENT",
            "NO_INCIDENT",
            "INCONCLUSIVE"
          ],
          "description": "Whether the evidence supports an agentic-system execution-integrity incident. A domain/security event under analysis does not by itself imply INCIDENT."
        },
        "support_status": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "INCONCLUSIVE"
          ]
        },
        "supporting_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ART-[0-9]{4,}$"
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "string",
          "description": "Brief evidence-grounded basis for the agentic incident-status determination."
        }
      }
    },
    "execution_context_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrity_status",
        "affected_agent",
        "first_integrity_anomaly_event_id",
        "support_status",
        "supporting_artifact_ids"
      ],
      "properties": {
        "integrity_status": {
          "type": "string",
          "enum": [
            "INTACT",
            "TAMPERED",
            "INCONCLUSIVE"
          ],
          "description": "Integrity of the affected agent execution context/policy, distinct from integrity of the forensic evidence package itself."
        },
        "affected_agent": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "A1",
                "A2",
                "A3",
                "A4",
                "A5"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "first_integrity_anomaly_event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^EVT-[0-9]{4,}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "support_status": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "INCONCLUSIVE"
          ]
        },
        "supporting_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ART-[0-9]{4,}$"
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "root_event_finding": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "agent_id",
            "claim_id",
            "artifact_id",
            "compromise_vector",
            "content_manipulation_type",
            "support_status",
            "supporting_artifact_ids"
          ],
          "properties": {
            "event_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^EVT-[0-9]{4,}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "agent_id": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "A1",
                    "A2",
                    "A3",
                    "A4",
                    "A5"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "claim_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^A[1-5]-C[0-9]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "artifact_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^ART-[0-9]{4,}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "compromise_vector": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "EXECUTION_CONTEXT_INJECTION",
                    "PROMPT_OR_POLICY_TAMPERING",
                    "PROVENANCE_TAMPERING",
                    "EVIDENCE_WITHHOLDING",
                    "MEMORY_STATE_TAMPERING",
                    "TOOL_OR_ACTION_MANIPULATION"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Reconstructed vector/mechanism by which the agentic execution was compromised; distinct from content_manipulation_type."
            },
            "content_manipulation_type": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "FALSE_CLAIM_INJECTION",
                    "EVIDENCE_REINTERPRETATION",
                    "PROVENANCE_LAUNDERING",
                    "SELECTIVE_OMISSION",
                    "UNAUTHORIZED_ACTION_ATTEMPT",
                    "UNAUTHORIZED_ACTION_EXECUTION",
                    "UNAUTHORIZED_CONTENT_MODIFICATION",
                    "UNAUTHORIZED_STATE_MODIFICATION",
                    "UNAUTHORIZED_DATA_DISCLOSURE",
                    "CAPABILITY_MISREPRESENTATION"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Reconstructed semantic manipulation introduced by the compromise."
            },
            "support_status": {
              "type": "string",
              "enum": [
                "SUPPORTED",
                "PARTIALLY_SUPPORTED",
                "INCONCLUSIVE"
              ]
            },
            "supporting_artifact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^ART-[0-9]{4,}$"
              },
              "uniqueItems": true
            },
            "basis": {
              "type": "string"
            }
          }
        }
      ]
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_order",
          "event_id",
          "agent_id",
          "finding",
          "support_status",
          "supporting_artifact_ids"
        ],
        "properties": {
          "event_order": {
            "type": "integer",
            "minimum": 1
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^EVT-[0-9]{4,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "agent_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A1",
                  "A2",
                  "A3",
                  "A4",
                  "A5"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "support_status": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "INCONCLUSIVE"
            ]
          },
          "supporting_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ART-[0-9]{4,}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "claim_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_claim_id",
          "to_claim_id",
          "relation",
          "support_status",
          "supporting_artifact_ids"
        ],
        "properties": {
          "from_claim_id": {
            "type": "string",
            "pattern": "^A[1-5]-C[0-9]+$"
          },
          "to_claim_id": {
            "type": "string",
            "pattern": "^A[1-5]-C[0-9]+$"
          },
          "relation": {
            "type": "string",
            "enum": [
              "ADOPTED",
              "AMPLIFIED",
              "CHALLENGED",
              "CORRECTED",
              "LAUNDERED"
            ]
          },
          "support_status": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "INCONCLUSIVE"
            ]
          },
          "supporting_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ART-[0-9]{4,}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "exposed_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "A1",
          "A2",
          "A3",
          "A4",
          "A5"
        ]
      },
      "uniqueItems": true
    },
    "contaminated_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "A1",
          "A2",
          "A3",
          "A4",
          "A5"
        ]
      },
      "uniqueItems": true
    },
    "corrective_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "A1",
          "A2",
          "A3",
          "A4",
          "A5"
        ]
      },
      "uniqueItems": true
    },
    "provenance_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "source_claim_ids",
          "source_evidence_ids",
          "source_artifact_ids",
          "finding_type",
          "support_status",
          "supporting_artifact_ids",
          "description"
        ],
        "properties": {
          "claim_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^A[1-5]-C[0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^A[1-5]-C[0-9]+$"
            },
            "uniqueItems": true,
            "description": "Upstream claim IDs reconstructed as provenance sources for claim_id. Use an empty array when no source claim can be supported."
          },
          "source_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E[0-9]+$"
            },
            "uniqueItems": true,
            "description": "Source evidence IDs reconstructed as provenance sources for claim_id. Use an empty array when no source evidence can be supported."
          },
          "finding_type": {
            "type": "string",
            "enum": [
              "PROVENANCE_INTACT",
              "PROVENANCE_MISSING",
              "PROVENANCE_INCONSISTENT",
              "PROVENANCE_LAUNDERED",
              "INCONCLUSIVE"
            ],
            "description": "Forensic assessment of whether the reconstructed provenance for this claim is intact, missing, inconsistent, laundered, or inconclusive."
          },
          "support_status": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "INCONCLUSIVE"
            ]
          },
          "supporting_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ART-[0-9]{4,}$"
            },
            "uniqueItems": true
          },
          "description": {
            "type": "string"
          },
          "source_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ART-[0-9]{4,}$"
            },
            "uniqueItems": true,
            "description": "Retained artifact IDs reconstructed as direct provenance sources for claim_id. Use an empty array when none is supported."
          }
        }
      },
      "uniqueItems": true
    },
    "impact_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_output_contaminated",
        "final_decision_affected",
        "external_effect_occurred",
        "support_status",
        "supporting_artifact_ids"
      ],
      "properties": {
        "final_output_contaminated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether incident-derived contaminated content reached the final system output through a supported causal/claim path."
        },
        "final_decision_affected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the agentic incident causally affected the final decision/outcome; ordinary model error unrelated to the incident is not sufficient."
        },
        "external_effect_occurred": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether an external action/effect attributable to the incident is supported."
        },
        "support_status": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "INCONCLUSIVE"
          ]
        },
        "supporting_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ART-[0-9]{4,}$"
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "evidence_integrity_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_integrity_status",
        "tampered_artifact_ids",
        "unverifiable_artifact_ids",
        "support_status",
        "supporting_artifact_ids"
      ],
      "properties": {
        "package_integrity_status": {
          "type": "string",
          "enum": [
            "INTACT",
            "TAMPERED",
            "UNVERIFIABLE",
            "INCONCLUSIVE"
          ],
          "description": "Integrity assessment of the retained forensic evidence package/records, distinct from execution_context_finding.integrity_status."
        },
        "tampered_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ART-[0-9]{4,}$"
          },
          "uniqueItems": true,
          "description": "Retained artifact IDs for which tampering or a content/hash mismatch is supported."
        },
        "unverifiable_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ART-[0-9]{4,}$"
          },
          "uniqueItems": true,
          "description": "Retained artifact IDs whose integrity cannot be verified from the available evidence."
        },
        "support_status": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "INCONCLUSIVE"
          ]
        },
        "supporting_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ART-[0-9]{4,}$"
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_type",
          "missing_artifact_ids",
          "description",
          "affected_conclusions"
        ],
        "properties": {
          "gap_type": {
            "type": "string",
            "enum": [
              "MISSING_ARTIFACT",
              "MISSING_PROVENANCE",
              "MISSING_CONTEXT_HISTORY",
              "MISSING_RAW_MESSAGE",
              "INTEGRITY_UNVERIFIABLE",
              "PARTIAL_LOG_SEQUENCE",
              "OTHER"
            ]
          },
          "missing_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ART-[0-9]{4,}$"
            },
            "uniqueItems": true,
            "description": "Artifact IDs inferred to be missing when those identifiers can be established from retained evidence; otherwise use an empty array."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "affected_conclusions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
